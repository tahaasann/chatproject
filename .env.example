# Copy to the relevant workspace .env file — NEVER commit real .env files.
# This file is documentation only; placeholder values are not secrets.

# --- Later: services/api/.env ---
# NODE_ENV=development
# HOST=0.0.0.0
# PORT=3001
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# CHAT_PROVIDER=echo
# OPENAI_API_KEY=sk-...   # server only, never in apps/


# --- Later: Supabase (after supabase start) ---
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Later: apps/app/.env (Vite requires VITE_ prefix) ---
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Later: apps/marketing/.env ---
# NEXT_PUBLIC_APP_URL=http://localhost:5173